{
  "name": "producing-curiosity",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.tools.json && vite build && tsx --tsconfig tsconfig.app.json scripts/build-experiment.tsx",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "check:deploy": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "p5": "1.11.13",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/p5": "1.7.7",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.152.0"
  }
}
