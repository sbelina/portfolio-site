# Alternate Worker/version hosts stay crawlable so noindex can be read.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

/404.html
  X-Robots-Tag: noindex

/system/*
  X-Robots-Tag: noindex

/lab/
  X-Robots-Tag: noindex, follow

/lab/atlas/*
  X-Robots-Tag: noindex, follow

/lab/edge-case/*
  X-Robots-Tag: noindex, follow

/notes/illustration-folded-margin/*
  X-Robots-Tag: noindex, follow
/references/illustration-unlabelled-tab/*
  X-Robots-Tag: noindex, follow
/perspective/illustration-open-bracket/*
  X-Robots-Tag: noindex, follow

/public-content.json
  X-Robots-Tag: noindex
/route-manifest.json
  X-Robots-Tag: noindex
/search-index.json
  X-Robots-Tag: noindex
/graph-index.json
  X-Robots-Tag: noindex
