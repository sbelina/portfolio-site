{
  "name": "producing-curiosity-private-local-trial",
  "main": "studio/worker.tsx",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-studio",
    "binding": "UI",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "private-writing-trial",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "test": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "private-writing-synthetic-test",
          "database_id": "00000000-0000-4000-8000-000000000002",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
