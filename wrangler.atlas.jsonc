{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-site-local-atlas-proof",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-atlas",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  }
}
